    {
      "t": "say",
      "who": "hastings",
      "text": "（他只点了点头，眼睛却在打量我，从头到脚，一寸不漏。）",
      "figs": [
        {
          "id": "emily",
          "pos": "left",
          "emotion": "neutral",
          "flip": false,
          "dim": false
        },
        {
          "id": "alfred",
