          "flip": false,
          "dim": false
        }
      ]
    },
    {
      "t": "say",
      "who": "narr",
      "text": "“你爱的人，你替她毁掉了一件证据。”波洛说，“而另一个人，正因为你毁了它而活得更安稳。”",
      "figs": [
        {
          "id": "poirot",
          "pos": "mid",
