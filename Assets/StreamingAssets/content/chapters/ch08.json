          "flip": false,
          "dim": false
        }
      ]
    },
    {
      "t": "say",
      "who": "narr",
      "text": "“我承认我在那里。”她说，“但我离开的时候，她还活着，还在写字。”",
      "figs": [
        {
          "id": "poirot",
          "pos": "mid",
          "emotion": "neutral",
          "flip": false,
          "dim": false
        },
        {
          "id": "lawrence",
          "pos": "right",
