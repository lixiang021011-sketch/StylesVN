[
  {
    "id": "dorcas",
    "name": "多卡斯",
    "role": "女管家",
    "topics": [
      {
        "id": "d1",
        "label": "下午那场争吵，你听到了什么？",
        "need": "",
        "give": "quarrel",
        "lines": [
          {
            "who": "dorcas",
            "text": "大概四点钟，我正好从门厅过。门关着，可女主人说话又尖又清楚。她说：\"你骗了我，欺骗了我。\""
          },
          {
            "who": "dorcas",
            "text": "后来她又说：\"是我养着你、给你衣服穿、给你饭吃！你竟这样报答我——给我们家带来耻辱！\""
          },
          {
            "who": "hastings",
            "text": "（那是英格尔索普先生在里面的声音吗？）"
          },
          {
            "who": "dorcas",
            "text": "我以为是。门里另一个人说话低得多，听不清。可除了先生，还能是谁呢？"
          }
        ]
      },
      {
        "id": "d2",
        "label": "五点那杯茶，她当时什么样子？",
        "need": "",
        "give": "tea",
        "lines": [
          {
            "who": "dorcas",
            "text": "五点整她按铃，让我送一杯茶到起居室，不要点心。她脸色白得吓人。"
          },
          {
            "who": "dorcas",
            "text": "她说：\"多卡斯，我受了很大的打击。\"她手里捏着一张写了字的纸，一直盯着看，像是不敢相信上面写的东西。"
          },
          {
            "who": "dorcas",
            "text": "她还低声念了一句：\"就这么几句话——一切都变了。\""
          }
        ]
      },
      {
        "id": "d3",
        "label": "公文包和钥匙是怎么回事？",
        "need": "",
        "give": "key",
        "lines": [
          {
            "who": "dorcas",
            "text": "那只紫包她每天早上带下楼，每晚带上楼，重要的纸都锁在里头。"
          },
          {
            "who": "dorcas",
            "text": "昨天午饭时她发现钥匙没了，让我好一通找。她为这个事儿很不高兴。"
          },
          {
            "who": "poirot",
            "text": "不过，她还有一把备用的，对吗？——好了，多卡斯，你看这是不是那把\"丢了\"的钥匙？"
          },
          {
            "who": "dorcas",
            "text": "天哪，先生！您在哪里找到的？我昨天翻遍了整栋房子！"
          }
        ]
      },
      {
        "id": "d4",
        "label": "她昨晚服了安眠药粉吗？",
        "need": "",
        "give": "bromide",
        "lines": [
          {
            "who": "dorcas",
            "text": "没有，先生，我敢担保。那盒溴化钾粉两天前就吃完了最后一包，她也没再让人去配。"
          },
          {
            "who": "poirot",
            "text": "那么盒子里是空的——这一点很重要。"
          }
        ]
      },
      {
        "id": "d5",
        "label": "昨晚的咖啡杯，是谁收的？",
        "need": "",
        "give": "cup_extra",
        "lines": [
          {
            "who": "dorcas",
            "text": "昨晚我出去了，是安妮收拾的。这丫头粗心，咖啡杯全留在客厅里没洗——等我不在就出这种事。"
          },
          {
            "who": "poirot",
            "text": "既然已经留下了，那就再留一会儿吧，我要看一看它们。"
          }
        ]
      },
      {
        "id": "d6",
        "label": "凌晨的时候，你是怎么被叫醒的？",
        "need": "",
        "give": "bell",
        "lines": [
          {
            "who": "dorcas",
            "text": "铃响得跟疯了一样，一下接一下。我披了衣服跑过去，门从里面闩死了，敲也没人应。"
          },
          {
            "who": "dorcas",
            "text": "里头有响动——像是桌子被撞翻，还有太太喘不上气的声音。再后来，大家都来了，我们撞开了门。"
          }
        ]
      }
    ]
  },
  {
    "id": "john",
    "name": "约翰·卡文迪什",
    "role": "死者继子",
    "topics": [
      {
        "id": "j1",
        "label": "关于遗产，你的处境如何？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "john",
            "text": "按我父亲的遗嘱，房子归我。可现钱全在我母亲手里——她每年改一次遗嘱，我们没人知道这一次写给了谁。"
          },
          {
            "who": "john",
            "text": "老实说，我缺钱。可这话由我自己说出来，听起来可不太妙，是吧？"
          }
        ]
      },
      {
        "id": "j2",
        "label": "昨天下午，她在和谁争吵？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "john",
            "text": "我不知道。我午后出去散步了。"
          },
          {
            "who": "hastings",
            "text": "（他说这话时，眼睛看着窗外。）"
          },
          {
            "who": "poirot",
            "text": "当然，先生。散步是极好的运动。"
          }
        ]
      },
      {
        "id": "j3",
        "label": "案发当晚，你在哪里？",
        "need": "",
        "give": "anon",
        "lines": [
          {
            "who": "john",
            "text": "我收到一封匿名信，说有人在树林那边等着谈我母亲的事。我在那儿站了一个多钟头，一个人也没来。"
          },
          {
            "who": "john",
            "text": "那封信我留着。笔迹——是我的笔迹。这就是最要命的地方。"
          }
        ]
      },
      {
        "id": "j4",
        "label": "玛丽知道你的处境吗？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "john",
            "text": "她什么都不知道。我们……我们之间已经很久不说话了。"
          },
          {
            "who": "poirot",
            "text": "（沉默。这位先生的问题，不在谋杀案里。）"
          }
        ]
      }
    ]
  },
  {
    "id": "mary",
    "name": "玛丽·卡文迪什",
    "role": "约翰之妻",
    "topics": [
      {
        "id": "m1",
        "label": "案发那天晚上，你在做什么？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "mary",
            "text": "四点半我醒了，正在穿衣，听见有重物落下的声音。我开门听了一会儿，接着铃响了，我就去叫多卡斯。"
          },
          {
            "who": "mary",
            "text": "门是锁着的。这一点我在调查庭上也说过了，先生。"
          }
        ]
      },
      {
        "id": "m2",
        "label": "你当时坐在起居室窗外的长椅上，对吗？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "mary",
            "text": "……是的。"
          },
          {
            "who": "mary",
            "text": "我什么也没听见。风很大，我只是在看书。"
          }
        ]
      },
      {
        "id": "m3",
        "label": "你和鲍尔斯坦医生很熟？",
        "need": "",
        "give": "bauer",
        "lines": [
          {
            "who": "mary",
            "text": "他懂毒物学，也懂很多别的事。丈夫不肯听我说话的时候，总得有人听。"
          },
          {
            "who": "hastings",
            "text": "（她把脸转开了一寸。那不是羞愧，是骄傲。）"
          }
        ]
      },
      {
        "id": "m4",
        "label": "你的劳动臂章上有一道裂口。",
        "need": "green",
        "give": "green2",
        "lines": [
          {
            "who": "mary",
            "text": "……"
          },
          {
            "who": "mary",
            "text": "是的。那天夜里，我在那个房间里。我在找一样东西，可我没有找到。"
          },
          {
            "who": "mary",
            "text": "如果说出来能帮到我丈夫，我早就说了。可这与他的罪与无罪，看上去毫无关系。"
          }
        ]
      }
    ]
  },
  {
    "id": "lawrence",
    "name": "劳伦斯·卡文迪什",
    "role": "死者继子",
    "topics": [
      {
        "id": "l1",
        "label": "你为什么坚持这是自然死亡？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "lawrence",
            "text": "因为……因为那样对大家都好。母亲年纪大了，心脏不好。"
          },
          {
            "who": "lawrence",
            "text": "而且您也看见了，她房里的门全是闩着的。谁进得去？谁出得来？"
          }
        ]
      },
      {
        "id": "l2",
        "label": "那只咖啡杯，你为什么踩碎它？",
        "need": "",
        "give": "love",
        "lines": [
          {
            "who": "lawrence",
            "text": "（他猛地站起来，又慢慢坐回去。）"
          },
          {
            "who": "lawrence",
            "text": "我没有。我进去的时候，它已经在地上碎了。"
          },
          {
            "who": "poirot",
            "text": "很好。那么，就让我们相信地板会自己碾碎一只杯子吧。"
          }
        ]
      },
      {
        "id": "l3",
        "label": "辛西娅在这个家里是什么位置？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "lawrence",
            "text": "她只是母亲收养的孩子。她在医院药房做事，手上有毒的。"
          },
          {
            "who": "lawrence",
            "text": "……我是说，别人会这么想。别人一定会这么想。"
          }
        ]
      }
    ]
  },
  {
    "id": "cynthia",
    "name": "辛西娅·默多克",
    "role": "养女 · 药房助手",
    "topics": [
      {
        "id": "c1",
        "label": "你在医院药房能拿到什么药？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "cynthia",
            "text": "什么都有一点。士的宁、吗啡、可卡因——药房里都有。所以我们才要登记得那么死板。"
          },
          {
            "who": "cynthia",
            "text": "您不会以为是我吧？我连老鼠都不敢毒。"
          }
        ]
      },
      {
        "id": "c2",
        "label": "案发前一晚，是你送她上楼的？",
        "need": "",
        "give": "cups",
        "lines": [
          {
            "who": "cynthia",
            "text": "是我。晚饭后我扶她上楼，她有点累，还带走了一杯咖啡。"
          },
          {
            "who": "cynthia",
            "text": "我把杯子放在她房里就回自己房间了。真的，只到门口。"
          }
        ]
      },
      {
        "id": "c3",
        "label": "你喝咖啡加糖吗？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "cynthia",
            "text": "不加，我讨厌甜的。怎么了？"
          },
          {
            "who": "poirot",
            "text": "（不加糖。那么那只留下糖的杯子，就不是她的。）"
          }
        ]
      },
      {
        "id": "c4",
        "label": "你觉得劳伦斯怎么样？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "cynthia",
            "text": "他讨厌我。他看我的样子，像是看见一只老鼠掉进了汤里。"
          },
          {
            "who": "poirot",
            "text": "（她说\"我不在乎\"，可她摆了摆手，快得像在赶一只苍蝇。）"
          }
        ]
      }
    ]
  },
  {
    "id": "evelyn",
    "name": "伊夫琳·霍华德",
    "role": "死者的女伴",
    "topics": [
      {
        "id": "e1",
        "label": "你和女主人吵过架？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "evelyn",
            "text": "是的，我们吵了。而且是当着全家的面。"
          },
          {
            "who": "evelyn",
            "text": "我告诉她，她那个丈夫是个下流胚。我说过的话，我一句都不收回。"
          }
        ]
      },
      {
        "id": "e2",
        "label": "你如此憎恨阿尔弗雷德·英格尔索普？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "evelyn",
            "text": "我打心里瞧不起他。这个人从头到脚都是假的，连他说话的语气都是装出来的。"
          },
          {
            "who": "poirot",
            "text": "（夫人，您的声音里有种过分的火气。人只有在害怕一件与自己有关的事时，才会这样用力。）"
          }
        ]
      },
      {
        "id": "e3",
        "label": "女主人给你写过一封信？",
        "need": "",
        "give": "eve_letter",
        "lines": [
          {
            "who": "evelyn",
            "text": "写了。七月十七日，就是她出事那天。"
          },
          {
            "who": "poirot",
            "text": "（你把信拿在手里转了一圈。英格尔索普太太写字，词与词之间总要留出很大空隙。可那个\"17日\"……挤得离奇。）"
          },
          {
            "who": "poirot",
            "text": "（\"1\"写在\"7\"的前面。那封信不是十七日写的，是七日写的。你在说谎，夫人。）"
          }
        ]
      },
      {
        "id": "e4",
        "label": "你是何时离开斯泰尔斯的？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "evelyn",
            "text": "七月七日下午。我坐车去了米德林厄姆，住在姐姐家。"
          },
          {
            "who": "evelyn",
            "text": "从那以后我没回过这栋房子——除了被叫来作证。"
          }
        ]
      }
    ]
  },
  {
    "id": "alfred",
    "name": "阿尔弗雷德·英格尔索普",
    "role": "死者的丈夫",
    "topics": [
      {
        "id": "a1",
        "label": "星期一傍晚六点，你在哪里？",
        "need": "",
        "give": "refuse",
        "lines": [
          {
            "who": "alfred",
            "text": "这与案件无关。"
          },
          {
            "who": "alfred",
            "text": "我拒绝回答。您可以把我送上法庭，但我不会为了一条毫无根据的指控，去公开一件私事。"
          }
        ]
      },
      {
        "id": "a2",
        "label": "药房的登记簿上有你的名字。",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "alfred",
            "text": "我从未走进那家药房。也从未买过一滴毒药。"
          },
          {
            "who": "alfred",
            "text": "如果簿子上有我的名字，那一定是有人替我签的——而那位先生的笔迹，您不妨拿去请人鉴定。"
          }
        ]
      },
      {
        "id": "a3",
        "label": "你妻子临终时喊的是你的名字。",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "alfred",
            "text": "（他用手捂住了脸。）"
          },
          {
            "who": "alfred",
            "text": "您要我怎么办？我……我配不上她。这一点我一直都知道。"
          }
        ]
      },
      {
        "id": "a4",
        "label": "你的遗产，你打算怎么用？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "alfred",
            "text": "钱是她的。她生前给我，我才拿；她不肯给，我也不会抢。"
          },
          {
            "who": "poirot",
            "text": "（这句话说得极漂亮。漂亮得像预先背过的台词。）"
          }
        ]
      }
    ]
  },
  {
    "id": "doctors",
    "name": "鲍尔斯坦医生 & 威尔金斯医生",
    "role": "毒物学权威 · 家庭医生",
    "topics": [
      {
        "id": "w1",
        "label": "（鲍尔斯坦）她的死因有疑问吗？",
        "need": "",
        "give": "fast",
        "lines": [
          {
            "who": "bauerstein",
            "text": "毫无疑问。士的宁。它作用于脊髓，肌肉在清醒中一寸寸锁死。死者到最后一刻都神志清醒——这是它最残忍的地方。"
          },
          {
            "who": "bauerstein",
            "text": "而且它极快：服下之后十几分钟到半小时就该发作。绝不会等上几个小时才动手。"
          }
        ]
      },
      {
        "id": "w2",
        "label": "（威尔金斯）她的补药里有士的宁？",
        "need": "",
        "give": "tonic",
        "lines": [
          {
            "who": "wilkins",
            "text": "是的，方子里有微量士的宁，作为补剂。她每晚服一剂，三周前在库特药房配了一大瓶。"
          },
          {
            "who": "wilkins",
            "text": "可那是极小的剂量，一瓶全喝下去也未必致命——除非有人动过那瓶药。"
          }
        ]
      },
      {
        "id": "w3",
        "label": "（鲍尔斯坦）您为何总在夜里的树林里？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "bauerstein",
            "text": "散步。夜里散步对我的健康有好处。"
          },
          {
            "who": "hastings",
            "text": "（几天后我们才知道，这个可疑的外国人为什么深夜出门。那是另一桩故事了。）"
          }
        ]
      }
    ]
  },
  {
    "id": "japp",
    "name": "贾普探长",
    "role": "苏格兰场",
    "topics": [
      {
        "id": "p1",
        "label": "你现在怀疑谁？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "japp",
            "text": "丈夫。百分之百。他从她身上捞到的东西最多，而且他连个不在场证明都不肯给。"
          },
          {
            "who": "japp",
            "text": "可要是您有别的想法，波洛先生，现在说还不算晚。"
          }
        ]
      },
      {
        "id": "p2",
        "label": "药房登记簿能定案吗？",
        "need": "",
        "give": "register",
        "lines": [
          {
            "who": "japp",
            "text": "上面是他的名字，是他家人的笔迹。我拿着它去请过专家，专家说是约翰·卡文迪什写的。"
          },
          {
            "who": "japp",
            "text": "再加上假胡子、夹鼻眼镜、房间里的空药瓶——法官会喜欢这个案子的。"
          }
        ]
      },
      {
        "id": "p3",
        "label": "为什么不立刻逮捕阿尔弗雷德？",
        "need": "",
        "give": "",
        "lines": [
          {
            "who": "japp",
            "text": "只要您点头，我明天早上就能把他铐上。"
          },
          {
            "who": "poirot",
            "text": "我的好贾普——现在逮捕他，就等于把他从绞刑架上救下来。"
          }
        ]
      }
    ]
  }
]