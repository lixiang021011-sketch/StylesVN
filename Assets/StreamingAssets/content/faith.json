[
  {
    "item": "艾米莉·英格尔索普死于士的宁中毒，死于七月十八日凌晨",
    "source": "第三章「悲剧之夜」",
    "kind": "忠于原著"
  },
  {
    "item": "三道门从中闩死，家人撞开房门",
    "source": "第三章",
    "kind": "忠于原著"
  },
  {
    "item": "凶手是丈夫阿尔弗雷德·英格尔索普与表亲、女伴伊夫琳·霍华德合谋",
    "source": "第十三章「波洛的解释」",
    "kind": "忠于原著"
  },
  {
    "item": "溴化物使补药中的士的宁沉淀析出，最后一剂成为致命剂量",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "伊夫琳化装成阿尔弗雷德去药房买毒药，并伪签约翰的笔迹",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "凶手故意布置指向自己的证据，图谋先被判无罪，从此逃脱再追诉",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "她在丈夫书桌里发现一封写给他同谋的信，遂烧掉刚立的新遗嘱",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "关键证据藏在壁炉台上的纸捻瓶里，因黑斯廷斯一句无心的话被波洛发现",
    "source": "第十二、十三章",
    "kind": "忠于原著"
  },
  {
    "item": "门闩上的绿色布片来自玛丽的劳动臂章；她当夜确实在死者房中",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "伊夫琳在调查庭出示的信，日期由「7月7日」改为「7月17日」",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "劳伦斯误以为辛西娅有罪，踩碎咖啡杯并坚持「自然死亡」说",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "波洛阻止逮捕阿尔弗雷德，是为了不让他被无罪开释后逃脱",
    "source": "第十三章",
    "kind": "忠于原著"
  },
  {
    "item": "鲍尔斯坦医生是毒物学权威，玛丽曾与他来往密切",
